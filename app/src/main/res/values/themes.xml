<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material Design 3 Light). -->
    <style name="Base.Theme.GeneSeqAnalyzer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Font Family Override for clean professional UI -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Color palette -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_blue_variant</item>

        <item name="colorSecondary">@color/secondary_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container_light</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnBackground">@color/text_primary_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.GeneSeq.CardView</item>
        <item name="materialButtonStyle">@style/Widget.GeneSeq.Button</item>
    </style>

    <style name="Theme.GeneSeqAnalyzer" parent="Base.Theme.GeneSeqAnalyzer" />

    <!-- Card style -->
    <style name="Widget.GeneSeq.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Button style -->
    <style name="Widget.GeneSeq.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Sequence Monospace Text Style -->
    <style name="TextAppearance.GeneSeq.Monospace" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- Header Text Style -->
    <style name="TextAppearance.GeneSeq.Header" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_blue</item>
    </style>
</resources>